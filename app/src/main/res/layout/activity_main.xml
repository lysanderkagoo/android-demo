<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/musicButton"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/m1"
        android:textColor="@color/white"
        app:backgroundTint="#00A231"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="80dp"
        app:rippleColor="@color/black"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/musicButton1"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="200dp"
        android:text="@string/m2"
        android:textColor="@color/white"
        app:backgroundTint="#9B691C"
        app:rippleColor="@color/black"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/musicButton2"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/m3"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="320dp"
        app:backgroundTint="#0008FF"
        app:rippleColor="@color/black"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/musicButton3"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/m4"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="450dp"
        app:backgroundTint="#64006D"
        app:rippleColor="@color/black"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopButton"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/stop"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="700dp"
        app:backgroundTint="#FF0000"
        app:rippleColor="@color/white"
        app:cornerRadius="7dp"
        app:strokeColor="#D1C4E9"
        app:strokeWidth="1.5dp"/>

    <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</androidx.constraintlayout.widget.ConstraintLayout>